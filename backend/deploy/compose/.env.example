SPRING_PROFILES_ACTIVE=production

# Config Server
CONFIG_SERVER_GIT_URI=https://github.com/your-org/ivyarc-config.git
CONFIG_SERVER_GIT_USERNAME=
CONFIG_SERVER_GIT_PASSWORD=
CONFIG_SERVER_GIT_BRANCH=main

# Gateway published port
API_GATEWAY_PORT=8080

# Eureka
EUREKA_DEFAULT_ZONE=http://eureka-server:8761/eureka

# Databases (external)
AUTH_DATABASE_URL=jdbc:postgresql://db-host:5432/auth_db
AUTH_DATABASE_USERNAME=auth_user
AUTH_DATABASE_PASSWORD=change-me

AUTHZ_DATABASE_URL=jdbc:postgresql://db-host:5432/authorization_db
AUTHZ_DATABASE_USERNAME=authorization_user
AUTHZ_DATABASE_PASSWORD=change-me

USER_DATABASE_URL=jdbc:postgresql://db-host:5432/user_management_db
USER_DATABASE_USERNAME=user_management_user
USER_DATABASE_PASSWORD=change-me

AUDIT_DATABASE_URL=jdbc:postgresql://db-host:5432/audit_db
AUDIT_DATABASE_USERNAME=audit_user
AUDIT_DATABASE_PASSWORD=change-me

# Redis (external)
REDIS_HOST=redis-host
REDIS_PORT=6379

# RabbitMQ (external)
RABBITMQ_ADDRESSES=amqps://user:pass@rabbit-host:5671/vhost

# Security
JWT_SECRET=replace-with-strong-secret

